    {"name": "Ts", "dtype": "Float64", "role": "sensor", "description": "Starboard propeller torque [kN]."},
    {"name": "Tp", "dtype": "Float64", "role": "sensor", "description": "Port propeller torque [kN]."},
    {"name": "T48", "dtype": "Float64", "role": "sensor", "description": "HP-turbine exit temperature [°C]."},
