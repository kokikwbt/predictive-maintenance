    {"name": "Pexh", "dtype": "Float64", "role": "sensor", "description": "Gas-turbine exhaust pressure [bar]."},
    {"name": "TIC", "dtype": "Float64", "role": "sensor", "description": "Turbine injection control [%]."},
    {"name": "mf", "dtype": "Float64", "role": "sensor", "description": "Fuel flow [kg/s]."},
    {"name": "kMc", "dtype": "Float64", "role": "target", "description": "Gas-turbine compressor degradation coefficient."},
    {"name": "kMt", "dtype": "Float64", "role": "target", "description": "Gas-turbine degradation coefficient."}
