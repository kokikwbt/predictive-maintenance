  "characteristics": {
    "kind": "Multi-table time series",
    "feature_dimensions": {
      "summary": "4 telemetry features",
      "counting": "Counts volt, rotate, pressure, and vibration; datetime and machineID are excluded from the 6 telemetry columns. Joining machine model and age adds two input fields before categorical encoding. Error, maintenance, and failure tables require task-specific joins or aggregation, so the engineered dimension is not fixed.",
      "sources": [
        {
          "name": "Microsoft sqlworkshops",
          "url": "https://github.com/microsoft/sqlworkshops/tree/master/SQLServerAndAzureMachineLearning/ML%20Services%20for%20SQL%20Server/data"
        }
      ]
    }
  },
  "tasks": [
    "Failure prediction",
    "RUL estimation",
    "Maintenance analysis"
  ],
  "task_support": {
    "anomaly_detection": "derived",
