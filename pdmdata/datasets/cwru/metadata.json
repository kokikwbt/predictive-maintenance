  "characteristics": {
    "kind": "Seeded-fault vibration recordings",
    "feature_dimensions": {
      "summary": "Up to three source accelerometer channels (DE, FE, BA), depending on recording",
      "counting": "Long-form rows retain independent channel sample indices and unmodified source values. Channels may have different lengths. Channel rates are documented where unambiguous; otherwise sample_rate_hz and time_s are null unless explicitly overridden.",
      "sources": [
        {
          "name": "CWRU collection and channel documentation",
          "url": "https://engineering.case.edu/bearingdatacenter/download-data-file"
        }
      ]
    }
  },
  "tasks": [
    "Fault classification",
    "Healthy/faulty discrimination",
    "Anomaly detection research",
    "Cross-condition adaptation",
    "Vibration signal analysis"
  ],
  "task_support": {
    "anomaly_detection": "direct",
    "fault_classification": "direct"
  },
  "attributes": [
    {
      "name": "amplitude",
      "dtype": "Float64",
      "role": "sensor",
      "description": "Unmodified selected accelerometer sample from the source MATLAB array."
    },
    {
      "name": "recording, collection",
      "dtype": "Mixed",
      "role": "entity",
      "description": "Official file identifier and collection: normal, 12k_de, 48k_de, or 12k_fe. Recordings are not independent machines."
    },
    {
      "name": "channel, source_variable",
      "dtype": "String",
      "role": "sensor",
      "description": "DE, FE or BA and the exact MATLAB variable name. Available channels are inspected per file."
    },
    {
      "name": "sample, time_s",
      "dtype": "Mixed",
      "role": "time",
      "description": "Original zero-based per-channel sample index; time_s is sample/rate when rate is known. Neither is an absolute timestamp."
    },
    {
      "name": "sample_rate_hz, rate_source",
      "dtype": "Mixed",
      "role": "provenance",
      "description": "Documented or user-overridden channel rate; null with unspecified origin when ambiguous. Overrides remain explicitly labeled."
    },
    {
      "name": "load_hp",
      "dtype": "UInt8",
      "role": "operating-condition",
      "description": "Motor load (0, 1, 2 or 3 horsepower) transcribed from the source table."
    },
    {
      "name": "fault, fault_location",
      "dtype": "String",
      "role": "target",
      "description": "normal, inner_race, ball or outer_race; fault_location identifies the defective bearing (DE/FE), not the accelerometer used."
    },
    {
      "name": "diameter_in, outer_race_position",
      "dtype": "Mixed",
      "role": "operating-condition",
      "description": "Seeded diameter (0 for normal) and clock position for outer-race defects, null when not applicable."
    },
    {
      "name": "rpm",
      "dtype": "Float64",
      "role": "operating-condition",
      "description": "Actual scalar source RPM if present, otherwise null; approximate source-table RPM is not substituted."
    }
  ],
  "notes": [
    "All 161 official links are indexed: normal (4), 12k_de (60), 48k_de (52), and 12k_fe (45). A missing source-table combination is not fabricated.",
    "Collection names identify the provider pages, not a guarantee that all channels share the heading's sampling rate. Normal rates, non-DE channels in 48k_de and the 0.028 inch files on the 12k page are left unspecified unless explicitly overridden.",
    "All collections are opt-in. The load0..load3 aliases preserve the original 52-file 12k_de subset (excluding 0.028 inch files), with 13 files per load. New collection variants include the complete source tables.",
    "The default loader remains recording 105, channel DE. Select channels='all' for long-form multi-channel output; unequal lengths are retained without padding or resampling.",
    "Normal and seeded-fault recordings support static healthy/faulty detection and fault-location classification. No within-run fault-onset, RUL, censoring, maintenance outcome, or naturally progressing failure labels are supplied.",
    "Use recording identity and operating conditions for experiment splits; random overlapping windows can leak source information. Only one test rig and four motor loads are represented.",
    "The provider's general apparatus narrative and collection tables use different outer-race orientation wording. The manifest retains clock positions from the collection tables without inferring a load-zone orientation.",
    "Official pages publish no versioned immutable release or source checksums. Local SHA-256 records identify downloaded bytes but are not provider-authenticated checksums.",
    "Identical copies across collection bundles and older load bundles are reused. Conflicting local copies raise an error instead of silently selecting one.",
    "Windowing, support/query episodes, normalization, class remapping and model training belong in task packages. Data loading never downloads implicitly."
  ],
  "citation": "Case Western Reserve University Bearing Data Center. Bearing fault data and experiment documentation. https://engineering.case.edu/bearingdatacenter/welcome"
}
