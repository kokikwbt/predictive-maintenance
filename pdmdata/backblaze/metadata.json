  "characteristics": {
    "kind": "Fleet-scale daily reliability panel",
    "feature_dimensions": {
      "summary": "Variable by quarter and drive model; e.g. 100 SMART fields in the 2018 Q1 schema",
      "counting": "Counts each raw and normalized SMART field separately (50 pairs in 2018 Q1). Date, serial number, model, capacity, and failure target are excluded. Later quarters have different schemas, and many SMART fields are missing for individual models; select columns from the actual downloaded quarter.",
      "sources": [
        {
          "name": "Backblaze quarterly schemas",
          "url": "https://f001.backblazeb2.com/file/Backblaze-Hard-Drive-Data/Drive_Stats_Schema_2018_Onward.csv"
        }
      ]
    }
  },
  "tasks": [
    "Drive failure prediction",
    "Survival analysis",
    "Time-to-event prediction"
  ],
  "task_support": {
    "anomaly_detection": "derived",
    "fault_classification": "direct",
    "condition_estimation": "derived",
    "rul_prediction": "derived",
    "time_to_event": "direct",
    "survival_analysis": "direct"
  },
  "attributes": [
    {
      "name": "date",
      "dtype": "Date",
      "role": "time",
      "description": "UTC date of the daily drive snapshot."
    },
    {
      "name": "serial_number",
      "dtype": "String",
      "role": "entity",
      "description": "Drive serial number used to construct longitudinal device histories."
    },
    {
      "name": "model / capacity_bytes",
      "dtype": "String/UInt64",
      "role": "asset-attribute",
      "description": "Drive model and capacity."
    },
    {
      "name": "failure",
      "dtype": "UInt8",
      "role": "target",
      "description": "One on the final day a drive is observed before a reported failure, otherwise zero."
    },
    {
      "name": "smart_*_raw / smart_*_normalized",
      "dtype": "Float64",
      "role": "sensor",
      "description": "Raw and normalized S.M.A.R.T. attributes; availability varies by drive model and quarter."
    }
  ],
  "notes": [
    "Data are partitioned by quarter to avoid requiring a full-history download.",
    "The default variant is 2025-q1; specify another quarter explicitly when required.",
    "Schema changes occur over time and S.M.A.R.T. attributes are highly sparse across drive models.",
    "Backblaze permits derivative works but asks users not to sell the source data itself.",
    "Quarterly archives are opt-in and are not downloaded by scripts/bootstrap.sh."
  ],
  "citation": "Backblaze. Drive Stats: Hard Drive Test Data. https://www.backblaze.com/cloud-storage/resources/hard-drive-test-data"
}
